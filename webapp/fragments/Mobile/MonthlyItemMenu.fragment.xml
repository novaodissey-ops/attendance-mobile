<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core">
	<Popover
		class="MobilePopover"
		showHeader="false"
		placement="Bottom">
		<List inset="false" 
                items="{path: 'clockModel>/menuAction', templateShareable: false,
                        filters: [{
                            path: 'ActionScreen',
                            operator: 'EQ',
                            value1: 'itemAction'
                            }] }"
                mode="SingleSelectMaster" 
                selectionChange="onMenuItemPress"
                class="sapUiMediumMarginTop">

                <StandardListItem
				class="MobileActionMenuRow"
                    title="{clockModel>Title}"
                    icon="{clockModel>Icon}"
                    visible="{clockModel>visible}"
                    iconDensityAware="false">
                    <customData>
                        <core:CustomData key="{clockModel>ActionScreen}" value="{clockModel>Action}"/>
                        <core:CustomData key="actionType" value="{clockModel>ActionType}"/>
                    </customData>
                </StandardListItem>

            </List>
	</Popover>
</core:FragmentDefinition>